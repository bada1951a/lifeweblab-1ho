---
import { getCollection } from 'astro:content';

// 1. 압축파일 원본 post 컬렉션에서 12개국 모든 포스트 경로 생성
export async function getStaticPaths() {
  const posts = await getCollection('post');
  
  return posts.map((post) => {
    // post.id: 'ko/test-post.md' -> cleanId: 'ko/test-post'
    const cleanId = post.id.replace(/\.[^/.]+$/, '');
    const parts = cleanId.split('/');
    const lang = parts[0]; // 'ko', 'en', 'ja' 등
    const slug = parts.slice(1).join('/'); // 'test-post'

    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

// 압축파일의 원본 날짜 포맷 (예: 23 Oct, 2026)
const dateObj = post.data.publishDate ? new Date(post.data.publishDate) : new Date();
const formattedDate = dateObj.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const authorName = post.data.author || 'LifeWebLab';
const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(authorName)}`;
const currentLang = Astro.params.lang || 'ko';
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — LifeWebLab</title>
  <meta name="description" content={post.data.description || post.data.excerpt || ''} />

  <!-- Bookworm Light 전용 정품 웹폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #ffffff;
      --text-title: #0f172a;
      --text-muted: #64748b;
      --text-body: #334155;
      --border: #f1f5f9;
      --primary: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-body);
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }

    header {
      border-bottom: 1px solid var(--border);
      background: #ffffff;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #0f172a;
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .back-btn {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .back-btn:hover {
      text-decoration: underline;
    }

    article {
      max-width: 900px;
      margin: 40px auto 100px auto;
      padding: 0 20px;
    }
    .post-header {
      margin-bottom: 36px;
    }

    /* 메타 정보 (아바타 / 날짜 / 카테고리) */
    .meta-row {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }
    .author-info {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #0f172a;
    }
    .author-avatar {
      width: 26px;
      height: 26px;
      border-radius: 50%;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .meta-icon {
      width: 16px;
      height: 16px;
      stroke: #64748b;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    h1.post-title {
      font-size: 2.35rem;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-title);
      margin-bottom: 24px;
      letter-spacing: -0.8px;
    }
    @media (max-width: 768px) {
      h1.post-title { font-size: 1.8rem; }
    }

    /* 상단 커버 이미지 */
    .post-cover {
      width: 100%;
      height: 440px;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 40px;
      background-color: #fce8db;
    }
    @media (max-width: 768px) {
      .post-cover { height: 260px; }
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* 마크다운 본문 타이포그래피 스타일 */
    .post-content {
      font-size: 1.08rem;
      color: #334155;
    }
    .post-content p {
      margin-bottom: 24px;
      line-height: 1.85;
    }
    .post-content h2 {
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--text-title);
      margin: 48px 0 18px 0;
      letter-spacing: -0.5px;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 8px;
    }
    .post-content h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-title);
      margin: 36px 0 14px 0;
    }
    .post-content ul, .post-content ol {
      margin-bottom: 24px;
      padding-left: 24px;
    }
    .post-content li {
      margin-bottom: 10px;
    }
    .post-content blockquote {
      border-left: 4px solid var(--primary);
      padding-left: 16px;
      margin: 24px 0;
      color: #64748b;
      font-style: italic;
    }
    .post-content code {
      background: #f1f5f9;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.9em;
      color: #ef4444;
    }
    .post-content pre {
      background: #0f172a;
      color: #f8fafc;
      padding: 20px;
      border-radius: 12px;
      overflow-x: auto;
      margin-bottom: 24px;
    }
    .post-content pre code {
      background: transparent;
      padding: 0;
      color: inherit;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">🐛 Bookworm</a>
      <a href="/" class="back-btn">← Home</a>
    </div>
  </header>

  <article>
    <div class="post-header">
      <div class="meta-row">
        <span class="author-info">
          <img src={avatarUrl} alt={authorName} class="author-avatar" />
          {authorName}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {formattedDate}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          {post.data.category || 'General'}
        </span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      {post.data.image && (
        <div class="post-cover">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      )}
    </div>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <footer>
    <p>Copyright © 2026 LifeWebLab • All rights reserved.</p>
  </footer>

</body>
</html>
