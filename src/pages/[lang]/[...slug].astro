---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  
  return posts.map((post) => {
    const cleanId = post.id.replace(/\.[^/.]+$/, '');
    const parts = cleanId.split('/');
    const lang = parts[0];
    const slug = parts.slice(1).join('/');

    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateObj = post.data.publishDate ? new Date(post.data.publishDate) : new Date();
const formattedDate = dateObj.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const authorName = post.data.author || 'Mark Dinn';
const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(authorName)}`;
const currentLang = Astro.params.lang || 'en';
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — LifeWebLab</title>
  <meta name="description" content={post.data.description || post.data.excerpt || ''} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --bg: #ffffff;
      --text-title: #0f172a;
      --text-muted: #64748b;
      --text-body: #334155;
      --border: #f1f5f9;
      --primary: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-body);
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }

    header {
      border-bottom: 1px solid var(--border);
      background: #ffffff;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 860px;
      margin: 0 auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.45rem;
      font-weight: 800;
      color: #0f172a;
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .back-btn {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    article {
      max-width: 860px;
      margin: 40px auto 100px auto;
      padding: 0 20px;
    }
    .post-header {
      margin-bottom: 36px;
    }

    .meta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 20px;
    }
    .author-info {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #0f172a;
    }
    .author-avatar {
      width: 28px !important;
      height: 28px !important;
      max-width: 28px !important;
      max-height: 28px !important;
      border-radius: 50% !important;
      object-fit: cover !important;
      display: inline-block !important;
    }
    .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .meta-icon {
      width: 16px !important;
      height: 16px !important;
      max-width: 16px !important;
      max-height: 16px !important;
      stroke: #64748b;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: inline-block !important;
    }

    h1.post-title {
      font-size: 2.3rem !important;
      font-weight: 800 !important;
      line-height: 1.35 !important;
      color: var(--text-title) !important;
      margin-bottom: 28px !important;
      letter-spacing: -0.6px !important;
    }
    @media (max-width: 768px) {
      h1.post-title { font-size: 1.75rem !important; }
    }

    .post-cover {
      width: 100%;
      height: 440px;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 40px;
      background-color: #f1f5f9;
    }
    @media (max-width: 768px) {
      .post-cover { height: 260px; margin-bottom: 28px; }
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* 본문 가독성 스타일 */
    .post-content {
      font-size: 1.15rem !important;
      line-height: 1.95 !important;
      color: #334155 !important;
    }
    .post-content p {
      font-size: 1.15rem !important;
      line-height: 1.95 !important;
      margin-bottom: 26px !important;
    }
    .post-content h2 {
      font-size: 1.7rem !important;
      font-weight: 800 !important;
      color: #0f172a !important;
      margin: 50px 0 20px 0 !important;
      border-bottom: 2px solid #f1f5f9 !important;
      padding-bottom: 10px !important;
      line-height: 1.35 !important;
    }
    .post-content h3 {
      font-size: 1.35rem !important;
      font-weight: 700 !important;
      color: #1e293b !important;
      margin: 38px 0 16px 0 !important;
      line-height: 1.4 !important;
    }
    .post-content ul, 
    .post-content ol {
      margin-bottom: 28px !important;
      padding-left: 24px !important;
      font-size: 1.12rem !important;
      line-height: 1.9 !important;
    }
    .post-content li {
      margin-bottom: 10px !important;
    }

    /* 배경색, 박스, 테두리를 완전히 없애서 일반 본문 글씨와 100% 동일하게 통일 */
    .post-content code {
      font-family: inherit !important;
      font-size: inherit !important;
      font-weight: 600 !important;
      background: transparent !important;
      background-color: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      color: inherit !important;
      letter-spacing: inherit !important;
    }

    /* 코드 블록(pre 내부)만 고정폭 개발용 서체 유지 */
    .post-content pre {
      background: #0f172a !important;
      color: #f8fafc !important;
      padding: 20px !important;
      border-radius: 12px !important;
      overflow-x: auto !important;
      margin-bottom: 28px !important;
    }
    .post-content pre code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
      background-color: transparent !important;
      color: inherit !important;
      padding: 0 !important;
      font-weight: normal !important;
    }

    .post-content img {
      max-width: 100% !important;
      height: auto !important;
      max-height: 460px !important;
      object-fit: cover !important;
      border-radius: 14px !important;
      display: block !important;
      margin: 36px auto !important;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08) !important;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">🧪 LifeWebLab</a>
      <a href="/" class="back-btn">← Home</a>
    </div>
  </header>

  <article>
    <div class="post-header">
      <div class="meta-row">
        <span class="author-info">
          <img src={avatarUrl} alt={authorName} class="author-avatar" />
          {authorName}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {formattedDate}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          {post.data.category || 'Troubleshooting'}
        </span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      {post.data.image && (
        <div class="post-cover">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      )}
    </div>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <footer>
    <p>Copyright © 2026 LifeWebLab • All rights reserved.</p>
  </footer>

</body>
</html>
