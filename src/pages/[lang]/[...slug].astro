---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  
  return posts.map((post) => {
    const cleanId = post.id.replace(/\.[^/.]+$/, '');
    const parts = cleanId.split('/');
    const lang = parts[0];
    const slug = parts.slice(1).join('/');

    return {
      params: { lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateObj = post.data.publishDate ? new Date(post.data.publishDate) : new Date();
const formattedDate = dateObj.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const authorName = post.data.author || 'Mark Dinn';
const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(authorName)}`;
const currentLang = Astro.params.lang || 'en';
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} — LifeWebLab</title>
  <meta name="description" content={post.data.description || post.data.excerpt || ''} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #ffffff;
      --text-title: #0f172a;
      --text-muted: #64748b;
      --text-body: #334155;
      --border: #f1f5f9;
      --primary: #2563eb;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-body);
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }

    header {
      border-bottom: 1px solid var(--border);
      background: #ffffff;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-family: 'Fredoka', sans-serif;
      font-size: 1.45rem;
      font-weight: 800;
      color: #0f172a;
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .back-btn {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.2s;
    }
    .back-btn:hover {
      text-decoration: underline;
      opacity: 0.85;
    }

    article {
      max-width: 860px;
      margin: 40px auto 100px auto;
      padding: 0 20px;
    }
    .post-header {
      margin-bottom: 40px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 18px;
    }
    .author-info {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #0f172a;
    }
    .author-avatar {
      width: 26px;
      height: 26px;
      border-radius: 50%;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .meta-icon {
      width: 16px;
      height: 16px;
      stroke: #64748b;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    h1.post-title {
      font-size: 2.35rem;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-title);
      margin-bottom: 28px;
      letter-spacing: -0.8px;
    }
    @media (max-width: 768px) {
      h1.post-title { font-size: 1.85rem; line-height: 1.35; }
    }

    .post-cover {
      width: 100%;
      height: 440px;
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 44px;
      background-color: #f1f5f9;
    }
    @media (max-width: 768px) {
      .post-cover { height: 260px; margin-bottom: 30px; }
    }
    .post-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
  </style>

  <style is:global>
    /* Global Typography & Enhanced Readability */
    .post-content {
      font-size: 1.15rem !important; /* ~18.5px */
      line-height: 1.95 !important;
      color: #334155 !important;
      word-break: break-word;
    }

    .post-content p {
      margin-bottom: 28px !important;
      line-height: 1.95 !important;
    }

    .post-content h2 {
      font-size: 1.75rem !important;
      font-weight: 800 !important;
      color: #0f172a !important;
      margin: 54px 0 20px 0 !important;
      letter-spacing: -0.5px !important;
      border-bottom: 2px solid #f1f5f9 !important;
      padding-bottom: 12px !important;
      line-height: 1.35 !important;
    }

    .post-content h3 {
      font-size: 1.4rem !important;
      font-weight: 700 !important;
      color: #1e293b !important;
      margin: 40px 0 16px 0 !important;
      line-height: 1.4 !important;
    }

    .post-content ul, 
    .post-content ol {
      margin-bottom: 28px !important;
      padding-left: 26px !important;
    }

    .post-content li {
      margin-bottom: 12px !important;
      line-height: 1.85 !important;
    }

    .post-content blockquote {
      border-left: 4px solid #2563eb !important;
      padding: 12px 20px !important;
      margin: 32px 0 !important;
      background: #f8fafc !important;
      border-radius: 0 8px 8px 0 !important;
      color: #475569 !important;
    }

    .post-content code {
      background: #f1f5f9 !important;
      padding: 3px 7px !important;
      border-radius: 6px !important;
      font-size: 0.9em !important;
      color: #2563eb !important;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    }

    .post-content pre {
      background: #0f172a !important;
      color: #f8fafc !important;
      padding: 22px !important;
      border-radius: 12px !important;
      overflow-x: auto !important;
      margin-bottom: 28px !important;
    }

    .post-content pre code {
      background: transparent !important;
      padding: 0 !important;
      color: inherit !important;
    }

    /* Images inside post body */
    .post-content img {
      max-width: 100% !important;
      height: auto !important;
      max-height: 480px !important;
      object-fit: cover !important;
      border-radius: 14px !important;
      display: block !important;
      margin: 40px auto !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
    }

    @media (max-width: 768px) {
      .post-content {
        font-size: 1.08rem !important;
        line-height: 1.85 !important;
      }
      .post-content h2 {
        font-size: 1.45rem !important;
        margin: 40px 0 16px 0 !important;
      }
      .post-content h3 {
        font-size: 1.25rem !important;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">🧪 LifeWebLab</a>
      <a href="/" class="back-btn">← Home</a>
    </div>
  </header>

  <article>
    <div class="post-header">
      <div class="meta-row">
        <span class="author-info">
          <img src={avatarUrl} alt={authorName} class="author-avatar" />
          {authorName}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {formattedDate}
        </span>
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          {post.data.category || 'Troubleshooting'}
        </span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>

      {post.data.image && (
        <div class="post-cover">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      )}
    </div>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <footer>
    <p>Copyright © 2026 LifeWebLab • All rights reserved.</p>
  </footer>

</body>
</html>
