---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Us - LifeWebLab',
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <header class="mb-8 md:mb-12 text-center">
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200"
      >
        Contact Us
      </h1>
      <p class="text-muted dark:text-slate-400 text-lg">
        Get in touch with the LifeWebLab editorial and payment systems research team
      </p>
    </header>

    <div
      class="mx-auto prose prose-lg dark:prose-invert max-w-none text-gray-700 dark:text-gray-300 leading-relaxed space-y-6"
    >
      <p>
        For inquiries regarding global payment troubleshooting guides, billing API integrations, errata corrections, or
        business collaboration opportunities, please reach out directly via email.
      </p>
      <p>
        Our editorial team reviews all technical submissions, payment scenario reports, and reader inquiries, striving
        to respond within <strong>2 to 3 business days</strong>.
      </p>

      <div
        class="mt-8 p-6 bg-gray-50 dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm"
      >
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2 mt-0">Official Contact Address</h2>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">
          Direct Editorial & Payment Systems Troubleshooting Inquiries
        </p>
        <!--email_off-->
        <div
          class="inline-block px-4 py-2 bg-white dark:bg-slate-900 rounded border border-gray-300 dark:border-slate-600 font-mono text-base font-semibold text-gray-800 dark:text-slate-200 select-all"
        >
          <span>contact</span>&#64;<span>lifeweblab.com</span>
        </div>
        <!--/email_off-->
        <p class="text-xs text-muted dark:text-slate-500 mt-3 mb-0">
          * Plain text address. Please copy and paste into your email client.
        </p>
      </div>
    </div>
  </section>
</Layout>
