---
import { getCollection } from 'astro:content';

// 1. post 컬렉션 및 blog 컬렉션의 글 경로(slug)를 모두 수집합니다
export async function getStaticPaths() {
  let posts = [];
  try {
    const postCol = await getCollection('post');
    if (postCol && postCol.length > 0) posts = postCol;
  } catch (e) {}

  if (posts.length === 0) {
    try {
      const blogCol = await getCollection('blog');
      if (blogCol && blogCol.length > 0) posts = blogCol;
    } catch (e) {}
  }

  return posts.map(post => {
    const cleanSlug = post.slug 
      ? post.slug.split('/').pop() 
      : post.id.replace(/\.[^/.]+$/, '').split('/').pop();

    return {
      params: { slug: cleanSlug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

// 12개국 지원 언어 목록
const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} - lifeweblab-1ho</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #222222;
            --muted-color: #777777;
            --border-color: #eaeaea;
            --primary-color: #10b981;
            --card-bg: #f5f2eb;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.7;
        }

        header {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: #111;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        nav {
            display: flex;
            gap: 18px;
            font-size: 0.95rem;
            font-weight: 500;
        }

        nav a {
            color: #444;
            text-decoration: none;
        }

        nav a:hover {
            color: var(--primary-color);
        }

        /* 지구본 언어 선택기 */
        .lang-picker {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 4px 10px;
            border-radius: 20px;
        }

        .globe-icon {
            width: 16px;
            height: 16px;
            color: #555;
        }

        .lang-select {
            border: none;
            background: transparent;
            font-size: 0.85rem;
            color: #333;
            outline: none;
            cursor: pointer;
            font-weight: 500;
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .post-header {
            margin-bottom: 35px;
            text-align: center;
        }

        .post-meta {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: var(--muted-color);
            margin-bottom: 16px;
        }

        .category-badge {
            color: var(--primary-color);
            font-weight: 600;
            text-decoration: none;
        }

        h1 {
            font-size: 2.2rem;
            font-weight: 800;
            color: #111;
            line-height: 1.35;
            margin-bottom: 20px;
        }

        .thumbnail-box {
            width: 100%;
            max-height: 420px;
            background: var(--card-bg);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 40px;
            overflow: hidden;
        }

        .thumbnail-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .post-content {
            font-size: 1.1rem;
            color: #333;
        }

        .post-content p {
            margin-bottom: 24px;
        }

        .post-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 20px 0;
        }

        .back-link {
            display: inline-block;
            margin-top: 50px;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        footer {
            max-width: 800px;
            margin: 80px auto 40px auto;
            padding: 20px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            font-size: 0.85rem;
            color: var(--muted-color);
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="logo">🐛 lifeweblab-1ho</a>
        <div class="header-right">
            <nav>
                <a href="/">Home</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </nav>

            <!-- 지구본 및 12개국 언어 선택 드롭다운 -->
            <div class="lang-picker">
                <svg class="globe-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <select class="lang-select" aria-label="Language selector">
                    {languages.map((lang) => (
                        <option value={lang.code}>{lang.label}</option>
                    ))}
                </select>
            </div>
        </div>
    </header>

    <main class="container">
        <article>
            <div class="post-header">
                <div class="post-meta">
                    {post.data.author && <span>{post.data.author} • </span>}
                    {post.data.publishDate && <span>{new Date(post.data.publishDate).toLocaleDateString()} • </span>}
                    {post.data.category && <a href="#" class="category-badge">{post.data.category}</a>}
                </div>
                <h1>{post.data.title}</h1>
            </div>

            {post.data.image && (
                <div class="thumbnail-box">
                    <img src={post.data.image} alt={post.data.title} />
                </div>
            )}

            <div class="post-content">
                <Content />
            </div>
        </article>

        <a href="/" class="back-link">← 홈으로 돌아가기</a>
    </main>

    <footer>
        <p>Copyright © 2026 lifeweblab-1ho • Built with Astro & Automated Pipeline</p>
    </footer>

</body>
</html>
