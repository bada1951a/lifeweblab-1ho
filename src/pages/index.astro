---
import { getCollection } from 'astro:content';

let allPosts = [];
try {
  allPosts = await getCollection('post');
} catch (e) {}

// 최신 발행일 순 정렬
allPosts.sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});

const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LifeWebLab</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #ffffff;
      --text-title: #1e293b;
      --text-muted: #64748b;
      --text-body: #475569;
      --border: #f1f5f9;
      --primary: #2563eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-title);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    header {
      border-bottom: 1px solid var(--border);
      background: #ffffff;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 1040px;
      margin: 0 auto;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      text-decoration: none;
      letter-spacing: -0.6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .header-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .nav-links {
      display: flex;
      gap: 20px;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      color: #334155;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary);
    }
    @media (max-width: 640px) {
      .nav-links { display: none; }
    }

    .lang-picker {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 6px 14px;
      border-radius: 9999px;
    }
    .lang-picker select {
      border: none;
      background: transparent;
      font-size: 0.85rem;
      font-weight: 700;
      color: #334155;
      outline: none;
      cursor: pointer;
      font-family: inherit;
    }

    main {
      max-width: 1040px;
      margin: 40px auto 100px auto;
      padding: 0 20px;
    }

    /* 최상단 메인 추천 글 (Featured Post - 1열 전폭 레이아웃) */
    .featured-container {
      margin-bottom: 56px;
    }
    .featured-item {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }
    .featured-thumb-wrapper {
      width: 100%;
      height: 440px;
      border-radius: 16px;
      overflow: hidden;
      background-color: #f1f5f9;
      margin-bottom: 24px;
    }
    @media (max-width: 768px) {
      .featured-thumb-wrapper { height: 260px; }
    }
    .featured-title {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.3;
      color: var(--text-title);
      margin-bottom: 14px;
      letter-spacing: -0.8px;
      transition: color 0.2s;
    }
    @media (max-width: 768px) {
      .featured-title { font-size: 1.7rem; }
    }
    .featured-item:hover .featured-title {
      color: var(--primary);
    }

    /* 하단 2열 그리드 */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 56px 40px;
    }
    @media (max-width: 768px) {
      .posts-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }
    }

    .post-item {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }
    .thumb-wrapper {
      width: 100%;
      height: 290px;
      border-radius: 14px;
      overflow: hidden;
      background-color: #f1f5f9;
      margin-bottom: 18px;
    }
    .thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.35s ease;
    }
    .post-item:hover .thumb-img, .featured-item:hover .thumb-img {
      transform: scale(1.02);
    }

    /* 공통 메타 정보 줄 */
    .meta-row {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .author-info {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #334155;
    }
    .author-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
    }
    .meta-icon {
      width: 16px;
      height: 16px;
      stroke: #64748b;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* 하단 2열 타이틀 */
    .post-title {
      font-size: 1.55rem;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-title);
      margin-bottom: 10px;
      letter-spacing: -0.6px;
      transition: color 0.2s;
    }
    .post-item:hover .post-title {
      color: var(--primary);
    }

    /* 본문 요약 */
    .post-excerpt {
      font-size: 0.96rem;
      color: var(--text-body);
      line-height: 1.65;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .no-posts {
      text-align: center;
      padding: 100px 20px;
      color: var(--text-muted);
      font-size: 1.1rem;
      font-weight: 600;
      display: none;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">
        🌱 LifeWebLab
      </a>

      <div class="header-nav">
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="#">About</a></li>
          <li><a href="#">Contact</a></li>
        </ul>

        <div class="lang-picker">
          <span>🌐</span>
          <select id="lang-selector" aria-label="언어 선택">
            {languages.map((lang) => (
              <option value={lang.code}>{lang.label}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- 언어별 글 목록 렌더링 컨테이너 -->
    <div id="posts-wrapper">
      {allPosts.map((post) => {
        // 원본 폴더 규격 유지: ko/글제목, en/글제목, ja/글제목 그대로 URL 형성
        const cleanId = post.id.replace(/\.[^/.]+$/, '');
        const postLang = cleanId.split('/')[0] || 'ko';
        const postUrl = `/${cleanId}`;

        const dateObj = post.data.publishDate ? new Date(post.data.publishDate) : new Date();
        const formattedDate = dateObj.toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });

        const authorName = post.data.author || 'Mark Dinn';
        const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(authorName)}`;

        return (
          <article class="post-card post-item" data-lang={postLang}>
            <a href={postUrl} class="thumb-wrapper">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="thumb-img" loading="lazy" />
              ) : (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #cbd5e1;">🖼️</div>
              )}
            </a>

            <div class="meta-row">
              <span class="author-info">
                <img src={avatarUrl} alt={authorName} class="author-avatar" />
                {authorName}
              </span>

              <span class="meta-item">
                <svg class="meta-icon" viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formattedDate}
              </span>

              <span class="meta-item">
                <svg class="meta-icon" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                {post.data.category || 'General'}
              </span>
            </div>

            <h2 class="post-title">
              <a href={postUrl} style="text-decoration: none; color: inherit;">{post.data.title}</a>
            </h2>

            <p class="post-excerpt">
              {post.data.description || post.data.excerpt || '해외 결제 및 글로벌 비즈니스 오류 해결 가이드입니다.'}
            </p>
          </article>
        );
      })}
    </div>

    <!-- 포스트가 없을 때 표시할 안내 박스 -->
    <div id="no-posts" class="no-posts">해당 언어로 작성된 포스팅이 아직 없습니다.</div>
  </main>

  <footer>
    <p>Copyright © 2026 LifeWebLab • All rights reserved.</p>
  </footer>

  <!-- 브라우저 언어 자동 감지 및 1위 대형 글 + 2열 그리드 동적 재배치 스크립트 -->
  <script is:inline>
    function setupLanguageFilter() {
      const selector = document.getElementById('lang-selector');
      const wrapper = document.getElementById('posts-wrapper');
      const allCards = Array.from(document.querySelectorAll('.post-card'));
      const noPosts = document.getElementById('no-posts');

      // 1. 브라우저 언어 감지 (한국어면 ko, 일본어면 ja, 영어면 en 등)
      const userLang = (navigator.language || navigator.userLanguage || 'ko').slice(0, 2).toLowerCase();
      const supported = ['ko', 'en', 'ja', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl', 'id', 'vi'];
      const defaultLang = supported.includes(userLang) ? userLang : 'ko';

      if (selector) {
        selector.value = defaultLang;
      }

      // 2. 선택된 언어 글만 추출하여 [1번째 대형 글 + 나머지 2열 그리드]로 재배치
      function renderLayoutForLang(targetLang) {
        const matched = allCards.filter(card => card.getAttribute('data-lang') === targetLang);

        wrapper.innerHTML = '';

        if (matched.length === 0) {
          if (noPosts) noPosts.style.display = 'block';
          return;
        }

        if (noPosts) noPosts.style.display = 'none';

        // 1번째 글: 대형 Featured 레이아웃
        const firstCard = matched[0];
        const featuredContainer = document.createElement('div');
        featuredContainer.className = 'featured-container';

        const thumbWrapper = firstCard.querySelector('.thumb-wrapper');
        if (thumbWrapper) thumbWrapper.className = 'featured-thumb-wrapper';

        const postTitle = firstCard.querySelector('.post-title');
        if (postTitle) postTitle.className = 'featured-title';

        featuredContainer.appendChild(firstCard);
        wrapper.appendChild(featuredContainer);

        // 2번째 글부터: 하단 2열 그리드에 배치
        if (matched.length > 1) {
          const gridContainer = document.createElement('div');
          gridContainer.className = 'posts-grid';

          for (let i = 1; i < matched.length; i++) {
            const card = matched[i];
            const tw = card.querySelector('.featured-thumb-wrapper');
            if (tw) tw.className = 'thumb-wrapper';

            const pt = card.querySelector('.featured-title');
            if (pt) pt.className = 'post-title';

            gridContainer.appendChild(card);
          }
          wrapper.appendChild(gridContainer);
        }
      }

      // 최초 실행
      renderLayoutForLang(defaultLang);

      // 사용자가 우측 상단 드롭다운 변경 시 즉시 반영
      if (selector) {
        selector.addEventListener('change', (e) => {
          renderLayoutForLang(e.target.value);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguageFilter);
    } else {
      setupLanguageFilter();
    }
  </script>
</body>
</html>
