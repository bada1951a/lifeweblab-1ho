---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 4호기 대문 이미지 불러오기 (src/assets/images/galaxy.png)
import galaxyImg from '~/assets/images/galaxy.png';

const metadata = {
  title: 'LifeWebLab — Global Web & Tech Troubleshooting Solutions',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Solutions',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: galaxyImg.src,
      alt: 'LifeWebLab - Global Web & Tech Solutions',
    }}
  >
    <Fragment slot="title">
      Global Web & Tech Solutions,<br />
      <span class="text-accent dark:text-white highlight">LifeWebLab</span>
    </Fragment>

    <Fragment slot="subtitle">
      Practical troubleshooting guides, payment gateway fixes, and actionable digital workflow blueprints for modern creators and entrepreneurs.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Troubleshooting Guides"
    information="Explore battle-tested solutions for global payment platforms, web infrastructure, and SaaS troubleshooting."
    count={8}
  />
</Layout>
