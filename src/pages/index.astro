---
import { getCollection } from 'astro:content';

let allPosts = [];
try {
  allPosts = await getCollection('post');
} catch (e) {}

// 최신 발행일 순 정렬
allPosts.sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});

const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LifeWebLab</title>
  
  <!-- Bookworm 순정 전용 폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #ffffff;
      --text-title: #0f172a;
      --text-muted: #64748b;
      --text-desc: #475569;
      --border: #f1f5f9;
      --primary: #2563eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-title);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* 상단 헤더 */
    header {
      background: #ffffff;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 1040px;
      margin: 0 auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #0f172a;
      text-decoration: none;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .header-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .nav-links {
      display: flex;
      gap: 20px;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      color: #475569;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary);
    }
    @media (max-width: 640px) {
      .nav-links { display: none; }
    }

    /* 12개국 지구본 셀렉터 */
    .lang-picker {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 6px 14px;
      border-radius: 9999px;
    }
    .lang-picker select {
      border: none;
      background: transparent;
      font-size: 0.85rem;
      font-weight: 700;
      color: #334155;
      outline: none;
      cursor: pointer;
      font-family: inherit;
    }

    /* 상단 대문 사진 배너 자리 */
    .hero-banner-container {
      max-width: 1040px;
      margin: 28px auto 0 auto;
      padding: 0 20px;
    }
    .hero-banner-img {
      width: 100%;
      height: 340px;
      border-radius: 18px;
      object-fit: cover;
      display: block;
      background-color: #fce8db;
    }
    @media (max-width: 768px) {
      .hero-banner-img {
        height: 200px;
      }
    }

    /* 포스트 메인 컨테이너 */
    main {
      max-width: 1040px;
      margin: 40px auto 100px auto;
      padding: 0 20px;
    }

    /* 스크린샷과 1:1로 일치하는 2열 카드 그리드 */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 40px;
    }
    @media (max-width: 768px) {
      .posts-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
    }

    .post-item {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    /* 둥근 사각형 썸네일 */
    .thumb-wrapper {
      width: 100%;
      height: 290px;
      border-radius: 14px;
      overflow: hidden;
      background-color: #f1f5f9;
      margin-bottom: 18px;
    }
    .thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .post-item:hover .thumb-img {
      transform: scale(1.02);
    }

    /* Bookworm 순정 메타 바 (아바타 + 작성자 + 달력 + 날짜 + 격자 카테고리) */
    .meta-row {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .author-info {
      display: flex;
      align-items: center;
      gap: 7px;
      font-weight: 500;
      color: #334155;
    }
    .author-avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      object-fit: cover;
      display: inline-block;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 500;
    }
    .meta-icon {
      width: 15px;
      height: 15px;
      stroke: #64748b;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* 볼드 대형 제목 (스크린샷 타이포그래피) */
    .post-title {
      font-size: 1.55rem;
      font-weight: 800;
      line-height: 1.35;
      color: var(--text-title);
      margin-bottom: 10px;
      letter-spacing: -0.5px;
      transition: color 0.2s;
    }
    .post-item:hover .post-title {
      color: var(--primary);
    }

    /* 본문 요약 */
    .post-excerpt {
      font-size: 0.95rem;
      color: var(--text-desc);
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .no-posts {
      grid-column: 1 / -1;
      text-align: center;
      padding: 90px 20px;
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 600;
      display: none;
    }

    /* 정갈한 푸터 */
    footer {
      border-top: 1px solid var(--border);
      background: #fafafa;
      padding: 50px 20px 35px 20px;
      color: var(--text-muted);
      font-size: 0.88rem;
    }
    .footer-inner {
      max-width: 1040px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }
    .footer-links {
      display: flex;
      gap: 20px;
      list-style: none;
    }
    .footer-links a {
      color: #475569;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }
    .footer-links a:hover {
      color: var(--primary);
    }
    .footer-bottom {
      border-top: 1px solid #e2e8f0;
      padding-top: 20px;
      text-align: center;
      color: #94a3b8;
      font-size: 0.82rem;
    }
  </style>
</head>
<body>

  <!-- 상단 헤더: Home + 핵심 카테고리 -->
  <header>
    <div class="header-inner">
      <a href="/" class="logo">
        🧪 LifeWebLab
      </a>

      <div class="header-nav">
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="#">LifeStyle</a></li>
          <li><a href="#">Food</a></li>
          <li><a href="#">Tech</a></li>
        </ul>

        <!-- 12개국 지구본 셀렉터 -->
        <div class="lang-picker">
          <span>🌐</span>
          <select id="lang-selector" aria-label="언어 선택">
            {languages.map((lang) => (
              <option value={lang.code}>{lang.label}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </header>

  <!-- 🌟 대문 사진 자리 (원하는 사진 주소로 언제든 교체 가능) 🌟 -->
  <div class="hero-banner-container">
    <img 
      src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1600&auto=format&fit=crop" 
      alt="LifeWebLab Banner" 
      class="hero-banner-img" 
    />
  </div>

  <!-- 포스트 2열 리스트 (스크린샷 원본 규격) -->
  <main>
    <div class="posts-grid" id="posts-container">
      {allPosts.map((post) => {
        const cleanId = post.id.replace(/\.[^/.]+$/, '');
        const postLang = cleanId.split('/')[0] || 'ko';
        const postUrl = `/${cleanId}`;

        // 스크린샷과 정확히 일치하는 날짜 표기 (예: 06 Apr, 2025)
        const dateObj = post.data.publishDate ? new Date(post.data.publishDate) : new Date();
        const formattedDate = dateObj.toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });

        // 작성자 및 동그란 프로필 아바타
        const authorName = post.data.author || 'Mark Dinn';
        const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(authorName)}`;

        return (
          <article class="post-item post-card" data-lang={postLang}>
            <!-- 상단 썸네일 -->
            <a href={postUrl} class="thumb-wrapper">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="thumb-img" loading="lazy" />
              ) : (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #cbd5e1;">🖼️</div>
              )}
            </a>

            <!-- 스크린샷 그대로 복원된 메타 정보 바 -->
            <div class="meta-row">
              <span class="author-info">
                <img src={avatarUrl} alt={authorName} class="author-avatar" />
                {authorName}
              </span>

              <!-- 달력 아이콘 + 날짜 -->
              <span class="meta-item">
                <svg class="meta-icon" viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formattedDate}
              </span>

              <!-- 카테고리 4개 사각 격자 아이콘 -->
              <span class="meta-item">
                <svg class="meta-icon" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                {post.data.category || 'LifeStyle'}
              </span>
            </div>

            <!-- 볼드 타이틀 -->
            <h2 class="post-title">
              <a href={postUrl} style="text-decoration: none; color: inherit;">{post.data.title}</a>
            </h2>

            <!-- 2줄 요약 설명 -->
            <p class="post-excerpt">
              {post.data.description || post.data.excerpt || 'Almost every day for the past nine or so months has felt like March 13, and that can sometimes make it difficult to want...'}
            </p>
          </article>
        );
      })}
      <div id="no-posts" class="no-posts">해당 언어로 작성된 포스팅이 아직 없습니다.</div>
    </div>
  </main>

  <!-- 하단 푸터: 필수 정책 링크 완비 -->
  <footer>
    <div class="footer-inner">
      <div class="footer-top">
        <a href="/" class="logo">🧪 LifeWebLab</a>
        <ul class="footer-links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy-policy">개인정보처리방침</a></li>
          <li><a href="/terms">이용약관</a></li>
        </ul>
      </div>
      <div class="footer-bottom">
        <p>Copyright © 2026 LifeWebLab • All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- 12개국 언어 감지 및 필터링 스크립트 -->
  <script is:inline>
    function setupLanguageFilter() {
      const selector = document.getElementById('lang-selector');
      const cards = document.querySelectorAll('.post-card');
      const noPosts = document.getElementById('no-posts');

      const userLang = (navigator.language || navigator.userLanguage || 'ko').slice(0, 2).toLowerCase();
      const supported = ['ko', 'en', 'ja', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl', 'id', 'vi'];
      const defaultLang = supported.includes(userLang) ? userLang : 'ko';

      if (selector) {
        selector.value = defaultLang;
      }

      function applyFilter(target) {
        let count = 0;
        cards.forEach(card => {
          if (card.getAttribute('data-lang') === target) {
            card.style.display = 'flex';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noPosts) {
          noPosts.style.display = count === 0 ? 'block' : 'none';
        }
      }

      applyFilter(defaultLang);

      if (selector) {
        selector.addEventListener('change', (e) => {
          applyFilter(e.target.value);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguageFilter);
    } else {
      setupLanguageFilter();
    }
  </script>
</body>
</html>
