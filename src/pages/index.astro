---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const featuredPost = allPosts[0];
const gridPosts = allPosts.slice(1);
---

<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>lifeweblab-1ho - Global Blog</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #222222;
            --muted-color: #777777;
            --border-color: #eaeaea;
            --primary-color: #10b981;
            --card-bg: #f5f2eb;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        header {
            max-width: 900px;
            margin: 0 auto;
            padding: 25px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            font-size: 1.6rem;
            font-weight: 800;
            color: #111;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        nav {
            display: flex;
            gap: 24px;
            font-size: 0.95rem;
            font-weight: 500;
        }

        nav a {
            color: #444;
            text-decoration: none;
        }

        nav a:hover {
            color: var(--primary-color);
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .post-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.88rem;
            color: var(--muted-color);
            margin-bottom: 12px;
        }

        .author-icon-box {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #fff;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }

        .category-badge {
            color: var(--primary-color);
            font-weight: 600;
            text-decoration: none;
        }

        /* 1. 상단 대문 사진 (Featured Post) */
        .featured-post {
            margin-bottom: 55px;
        }

        .featured-thumbnail {
            width: 100%;
            height: 420px;
            background: var(--card-bg);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 6rem;
            margin-bottom: 20px;
        }

        .post-title-large {
            font-size: 2.1rem;
            font-weight: 800;
            color: #111;
            text-decoration: none;
            display: block;
            margin-bottom: 12px;
            line-height: 1.25;
        }

        .post-title-large:hover, .post-title-small:hover {
            color: var(--primary-color);
        }

        .post-desc {
            font-size: 1.02rem;
            color: #555;
            margin-bottom: 0;
        }

        /* 2. 하단 2열 그리드 */
        .grid-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 45px 30px;
            margin-top: 40px;
        }

        .grid-thumbnail {
            width: 100%;
            height: 240px;
            background: var(--card-bg);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            margin-bottom: 16px;
        }

        .post-title-small {
            font-size: 1.4rem;
            font-weight: 700;
            color: #111;
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        footer {
            max-width: 900px;
            margin: 80px auto 40px auto;
            padding: 20px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            font-size: 0.85rem;
            color: var(--muted-color);
        }

        @media (max-width: 768px) {
            .grid-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="logo">🐛 lifeweblab-1ho</a>
        <nav>
            <a href="/">Home</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <main class="container">
        {featuredPost && (
            <article class="featured-post">
                <div class="featured-thumbnail">
                    {featuredPost.data.image}
                </div>
                <div class="post-meta">
                    <div class="author-icon-box">{featuredPost.data.avatarIcon}</div>
                    <span>{featuredPost.data.author}</span>
                    <span>•</span>
                    <span>{featuredPost.data.date}</span>
                    <span>•</span>
                    <a href="#" class="category-badge">{featuredPost.data.category}</a>
                </div>
                <h2><a href={`/${featuredPost.id}/`} class="post-title-large">{featuredPost.data.title}</a></h2>
                <p class="post-desc">{featuredPost.data.description}</p>
            </article>
        )}

        <div class="grid-container">
            {gridPosts.map(post => (
                <article class="grid-item">
                    <div class="grid-thumbnail">
                        {post.data.image}
                    </div>
                    <div class="post-meta">
                        <div class="author-icon-box">{post.data.avatarIcon}</div>
                        <span>{post.data.author}</span>
                        <span>•</span>
                        <span>{post.data.date}</span>
                        <span>•</span>
                        <a href="#" class="category-badge">{post.data.category}</a>
                    </div>
                    <h3><a href={`/${post.id}/`} class="post-title-small">{post.data.title}</a></h3>
                    <p class="post-desc" style="font-size: 0.95rem;">{post.data.description}</p>
                </article>
            ))}
        </div>
    </main>

    <footer>
        <p>Copyright © 2026 lifeweblab-1ho.com • Built with Astro & Automated Pipeline</p>
    </footer>

</body>
</html>
