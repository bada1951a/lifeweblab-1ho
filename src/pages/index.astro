---
import Layout from '~/layouts/PageLayout.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'LifeWebLab — 글로벌 결제 & 비즈니스 솔루션',
  ignoreTitleTemplate: true,
};

// post 컬렉션 글 가져오기
let posts = [];
try {
  posts = await getCollection('post');
} catch (e) {}

// 한국어(ko) 글 우선 정렬 (없으면 전체 글 표시)
const koPosts = posts.filter(post => post.id.startsWith('ko/'));
const displayPosts = koPosts.length > 0 ? koPosts : posts;
---

<Layout metadata={metadata}>
  <!-- 인트로(Hero) 없이 바로 최신 글 목록을 매거진 형태로 출력 -->
  <BlogLatestPosts
    title="최신 문제해결 가이드"
    information={`해외 결제 및 비즈니스 관련 최신 문제해결 가이드 목록입니다.`}
  />
</Layout>
