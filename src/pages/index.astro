---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'LifeWebLab — Global Troubleshooting & Solutions',
  ignoreTitleTemplate: true,
};

// 1. post 컬렉션의 모든 글 수집
let allPosts = [];
try {
  allPosts = await getCollection('post');
} catch (e) {}

// 최신 발행일 순 정렬
allPosts.sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});

const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 max-w-6xl mx-auto">
    <!-- 헤더 컨트롤: 타이틀 + 언어 선택 지구본 셀렉터 -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 dark:border-gray-700 pb-6 mb-8 gap-4">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white" id="main-title">
          최신 문제해결 가이드
        </h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2 text-sm sm:text-base" id="main-desc">
          해외 결제 및 비즈니스 관련 실무 해결 가이드 목록입니다.
        </p>
      </div>

      <!-- 언어 전환 드롭다운 -->
      <div class="inline-flex items-center gap-2 bg-gray-100 dark:bg-gray-800 px-3 py-1.5 rounded-full border border-gray-300 dark:border-gray-600 self-start sm:self-auto">
        <span class="text-base">🌐</span>
        <select id="lang-selector" class="bg-transparent text-sm font-semibold text-gray-800 dark:text-gray-200 outline-none cursor-pointer">
          {languages.map((lang) => (
            <option value={lang.code} class="text-gray-900 bg-white dark:bg-gray-800 dark:text-white">
              {lang.label}
            </option>
          ))}
        </select>
      </div>
    </div>

    <!-- 카드 그리드 목록 (전체 글을 렌더링하되 언어별 data-lang 속성 부여) -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="posts-container">
      {allPosts.map((post) => {
        // post.id 앞자리에서 언어 코드 추출 (예: 'ko/test-post.md' -> 'ko')
        const postLang = post.id.split('/')[0] || 'ko';
        const cleanSlug = post.slug ? post.slug.split('/').pop() : post.id.replace(/\.[^/.]+$/, '').split('/').pop();
        const postUrl = `/blog/${cleanSlug}`;

        return (
          <article 
            class="post-card flex flex-col bg-white dark:bg-slate-900 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition duration-200"
            data-lang={postLang}
          >
            {post.data.image && (
              <a href={postUrl} class="block h-48 overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover hover:scale-105 transition duration-300" loading="lazy" />
              </a>
            )}
            <div class="flex-1 p-5 flex flex-col justify-between">
              <div>
                <span class="inline-block text-xs font-semibold text-primary uppercase tracking-wider mb-2">
                  {post.data.category || 'Guide'}
                </span>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2 leading-snug hover:text-primary transition">
                  <a href={postUrl}>{post.data.title}</a>
                </h2>
                <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                  {post.data.description || post.data.excerpt || ''}
                </p>
              </div>
              <div class="text-xs text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-3 flex justify-between">
                <span>{post.data.publishDate ? new Date(post.data.publishDate).toLocaleDateString() : ''}</span>
                <span class="uppercase font-bold tracking-widest">{postLang}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 선택된 언어 글이 없을 때 표시되는 상태 -->
    <div id="no-posts" class="hidden text-center py-20 text-gray-500">
      <p class="text-lg">해당 언어로 작성된 포스팅이 아직 없습니다.</p>
    </div>
  </section>

  <!-- 접속자 국적(브라우저 언어) 감지 및 실시간 언어 필터링 스크립트 -->
  <script is:inline>
    function detectAndFilterLanguage() {
      const selector = document.getElementById('lang-selector');
      const cards = document.querySelectorAll('.post-card');
      const noPostsMsg = document.getElementById('no-posts');

      // 1. 브라우저 언어 확인 (한국어면 ko, 일본어면 ja, 영어면 en 등)
      const userLang = (navigator.language || navigator.userLanguage || 'ko').slice(0, 2).toLowerCase();
      
      // 지원 언어 목록에 있는지 검사 후 기본 선택 설정
      const supportedLangs = ['ko', 'en', 'ja', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl', 'id', 'vi'];
      const targetLang = supportedLangs.includes(userLang) ? userLang : 'ko';

      if (selector) {
        selector.value = targetLang;
      }

      // 2. 화면에 해당 언어 카드만 남기고 숨기기
      function filterPosts(langCode) {
        let visibleCount = 0;
        cards.forEach(card => {
          if (card.getAttribute('data-lang') === langCode) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noPostsMsg) {
          noPostsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      // 최초 접속 시 감지된 국적 언어로 실행
      filterPosts(targetLang);

      // 사용자가 우측 상단 드롭다운에서 언어를 수동 변경했을 때 즉시 반영
      if (selector) {
        selector.addEventListener('change', (e) => {
          filterPosts(e.target.value);
        });
      }
    }

    // 문서 로드 즉시 실행
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', detectAndFilterLanguage);
    } else {
      detectAndFilterLanguage();
    }
  </script>
</Layout>
