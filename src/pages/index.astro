---
import Layout from '~/layouts/PageLayout.astro';

// 대문 이미지(JPG) 불러오기
import heroImage from '~/assets/images/satellite-earth.jpg';

const metadata = {
  title: 'LifeWebLab — Global Billing & Payment Troubleshooting Hub',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section (순수 Tailwind CSS 적용) -->
  <section class="relative md:-mt-[76px] not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
      <div class="py-12 md:py-20 lg:py-0 lg:flex lg:items-center lg:h-screen lg:gap-8">
        <div class="basis-1/2 text-center lg:text-left pb-10 md:pb-16 mx-auto">
          <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
            Global Payment & Billing Solutions,<br />
            <span class="text-blue-600 dark:text-blue-400">LifeWebLab</span>
          </h1>
          <div class="max-w-3xl mx-auto lg:max-w-none">
            <p class="text-xl text-muted mb-6 dark:text-slate-300">
              Comprehensive troubleshooting guides for overseas payments, recurring billing errors, and digital invoices.
            </p>
            <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 lg:justify-start">
              <a
                class="btn btn-primary inline-flex items-center justify-center py-3 px-6 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition"
                href="/blog"
              >
                Explore Guides
              </a>
            </div>
          </div>
        </div>
        <div class="basis-1/2">
          {heroImage && (
            <div class="relative m-auto max-w-5xl">
              <img
                src={heroImage.src || heroImage}
                alt="Troubleshooting Tutorials - LifeWebLab Cover"
                class="mx-auto rounded-md w-full shadow-lg"
              />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- 방문자 언어 감지 및 자동 분기 스크립트 -->
<script is:inline>
  (function () {
    if (window.location.pathname !== '/' && window.location.pathname !== '') return;

    const rawLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    const langCode = rawLang.split('-')[0];

    const supportedLangs = {
      ko: '/ko',
      ja: '/ja',
      de: '/de',
      fr: '/fr',
      es: '/es',
      zh: '/zh',
      it: '/it',
      pt: '/pt',
      ru: '/ru',
      nl: '/nl',
      pl: '/pl',
      en: '/en'
    };

    if (supportedLangs[langCode]) {
      if (!sessionStorage.getItem('lang_redirected')) {
        sessionStorage.setItem('lang_redirected', 'true');
        window.location.replace(supportedLangs[langCode]);
      }
    }
  })();
</script>
