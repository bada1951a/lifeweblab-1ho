---
// lifeweblab-1ho - Bookworm 감성 홈 템플릿
const posts = [
  {
    title: "¿Qué hacer si Stripe muestra el error do_not_honor y rechaza tarjetas internacionales?",
    description: "Durante la sincronización de pasarelas de pago globales, uno de los fallos más críticos es cuando el banco emisor bloquea la transacción sin explicaciones detalladas...",
    date: "23 Oct, 2026",
    category: "Business",
    author: "Tech Doctor",
    image: "💳",
    url: "#"
  },
  {
    title: "¿Por qué aparece la retención de 21 días en cuentas nuevas de PayPal Business y cómo liberarla?",
    description: "Análisis detallado del mecanismo de retención estándar en pasarelas de pago transfronterizas y métodos automatizados para registrar comprobantes de envío válidos.",
    date: "23 Oct, 2026",
    category: "Business",
    author: "Tech Doctor",
    image: "📦",
    url: "#"
  },
  {
    title: "Solución al error de permisos S3 Bucket Access Denied y configuración IAM Policy recomendada",
    description: "Resolución de bloqueos de políticas de acceso público y errores de configuración de permisos IAM para infraestructura en la nube.",
    date: "23 Oct, 2026",
    category: "Business",
    author: "Tech Doctor",
    image: "☁️",
    url: "#"
  }
];
---

<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>lifeweblab-1ho.com - Global SaaS & Fintech Lab</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #222222;
            --muted-color: #777777;
            --border-color: #eaeaea;
            --primary-color: #10b981;
            --card-bg: #fdfbf7;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        header {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            font-size: 1.6rem;
            font-weight: 800;
            color: #111;
            text-decoration: none;
        }

        nav {
            display: flex;
            gap: 24px;
            font-size: 0.95rem;
            font-weight: 500;
        }

        nav a {
            color: #444;
            text-decoration: none;
        }

        nav a:hover {
            color: var(--primary-color);
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .post-card {
            margin-bottom: 60px;
            background: #fff;
            border-radius: 12px;
        }

        .post-thumbnail {
            width: 100%;
            height: 380px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .post-thumbnail:hover {
            transform: translateY(-4px);
        }

        .post-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.85rem;
            color: var(--muted-color);
            margin-bottom: 12px;
        }

        .author-img {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #ccc;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            color: #fff;
            font-weight: bold;
        }

        .post-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #111;
            text-decoration: none;
            display: block;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .post-title:hover {
            color: var(--primary-color);
        }

        .post-desc {
            font-size: 1.05rem;
            color: #555;
            margin-bottom: 20px;
        }

        footer {
            max-width: 800px;
            margin: 60px auto 40px auto;
            padding: 20px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            font-size: 0.85rem;
            color: var(--muted-color);
        }
    </style>
</head>
<body>

    <header>
        <a href="#" class="logo">🐛 lifeweblab-1ho</a>
        <nav>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <main class="container">
        {posts.map(post => (
            <article class="post-card">
                <div class="post-thumbnail">
                    {post.image}
                </div>
                <div class="post-meta">
                    <span class="author-img">TD</span>
                    <span>{post.author}</span>
                    <span>•</span>
                    <span>{post.date}</span>
                    <span>•</span>
                    <span style="color: var(--primary-color); font-weight: 600;">{post.category}</span>
                </div>
                <h2><a href={post.url} class="post-title">{post.title}</a></h2>
                <p class="post-desc">{post.description}</p>
            </article>
        ))}
    </main>

    <footer>
        <p>Copyright © 2026 lifeweblab-1ho.com • Built with Astro & Automated Pipeline</p>
    </footer>

</body>
</html>
