---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 대문 이미지(JPG) 불러오기
import heroImage from '~/assets/images/satellite-earth.jpg';

const metadata = {
  title: 'LifeWebLab — Global Billing & Payment Troubleshooting Hub',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Guides',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: heroImage,
      alt: 'Troubleshooting Tutorials - LifeWebLab Cover',
    }}
  >
    <Fragment slot="title">
      Global Payment & Billing Solutions,<br />
      <span class="text-accent dark:text-white highlight">LifeWebLab</span>
    </Fragment>

    <Fragment slot="subtitle">
      Comprehensive troubleshooting guides for overseas payments, recurring billing errors, and digital invoices.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Articles"
    information="Carefully curated troubleshooting guides and resolution steps for payment failures."
    count={6}
  />
</Layout>

<!-- 방문자 언어 감지 및 자동 분기 스크립트 -->
<script is:inline>
  (function () {
    // 사용자가 이미 특정 페이지를 둘러보는 중이 아니라 '메인 루트(/)'로 직접 들어왔을 때만 작동
    if (window.location.pathname !== '/' && window.location.pathname !== '') return;

    // 브라우저 기본 언어 확인 (예: 'ko-KR' -> 'ko', 'ja' -> 'ja')
    const rawLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    const langCode = rawLang.split('-')[0];

    // 지원하는 주요 언어 매핑
    const supportedLangs = {
      ko: '/ko',
      ja: '/ja',
      de: '/de',
      fr: '/fr',
      es: '/es',
      zh: '/zh',
      it: '/it',
      pt: '/pt',
      ru: '/ru',
      nl: '/nl',
      pl: '/pl',
      en: '/en'
    };

    // 한국어면 /ko, 일본어면 /ja 등으로 이동 (매핑 없으면 기본 영어 /en 또는 그대로 유지)
    if (supportedLangs[langCode]) {
      // 무한 루프 방지를 위해 sessionStorage 체크
      if (!sessionStorage.getItem('lang_redirected')) {
        sessionStorage.setItem('lang_redirected', 'true');
        window.location.replace(supportedLangs[langCode]);
      }
    }
  })();
</script>
