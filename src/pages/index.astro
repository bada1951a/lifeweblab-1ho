---
import { getCollection } from 'astro:content';

let allPosts = [];
try {
  allPosts = await getCollection('post');
} catch (e) {}

// 최신 발행일 순 정렬
allPosts.sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});

const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LifeWebLab — Global Troubleshooting & Solutions</title>
  <style>
    :root {
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-sub: #64748b;
      --primary: #2563eb;
      --border: #e2e8f0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif; background-color: var(--bg); color: var(--text-main); line-height: 1.6; }
    header { background: #ffffff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50; }
    .header-inner { max-width: 1200px; margin: 0 auto; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 1.3rem; font-weight: 800; color: var(--text-main); text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .lang-picker { display: flex; align-items: center; gap: 6px; background: #f1f5f9; border: 1px solid var(--border); padding: 5px 12px; border-radius: 20px; }
    .lang-picker select { border: none; background: transparent; font-size: 0.85rem; font-weight: 600; color: var(--text-main); outline: none; cursor: pointer; }
    main { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .title-area { border-bottom: 2px solid var(--border); padding-bottom: 16px; margin-bottom: 32px; }
    .title-area h1 { font-size: 1.8rem; font-weight: 800; }
    .title-area p { color: var(--text-sub); font-size: 0.95rem; margin-top: 4px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
    .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
    .card-thumb { width: 100%; height: 180px; background: #e2e8f0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .card-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; }
    .badge { font-size: 0.75rem; font-weight: 700; color: var(--primary); text-transform: uppercase; margin-bottom: 8px; }
    .card-title { font-size: 1.15rem; font-weight: 700; line-height: 1.4; margin-bottom: 8px; color: var(--text-main); }
    .card-desc { font-size: 0.88rem; color: var(--text-sub); line-height: 1.5; margin-bottom: 16px; flex-grow: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .card-footer { font-size: 0.78rem; color: #94a3b8; border-top: 1px solid #f1f5f9; padding-top: 12px; display: flex; justify-content: space-between; }
    .no-posts { text-align: center; padding: 60px 20px; color: var(--text-sub); font-size: 1rem; width: 100%; grid-column: 1 / -1; display: none; }
    footer { text-align: center; padding: 30px 20px; border-top: 1px solid var(--border); margin-top: 60px; font-size: 0.85rem; color: var(--text-sub); background: #ffffff; }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="logo">LifeWebLab</a>
      <div class="lang-picker">
        <span>🌐</span>
        <select id="lang-selector" aria-label="Language selector">
          {languages.map((lang) => (
            <option value={lang.code}>{lang.label}</option>
          ))}
        </select>
      </div>
    </div>
  </header>

  <main>
    <div class="title-area">
      <h1>최신 문제해결 가이드</h1>
      <p>해외 결제 및 글로벌 비즈니스 오류 해결 솔루션입니다.</p>
    </div>

    <div class="grid" id="posts-container">
      {allPosts.map((post) => {
        const postLang = post.id.split('/')[0] || 'ko';
        const cleanSlug = post.slug ? post.slug.split('/').pop() : post.id.replace(/\.[^/.]+$/, '').split('/').pop();
        const postUrl = `/${cleanSlug}`;

        return (
          <a href={postUrl} class="card post-card" data-lang={postLang}>
            <div class="card-thumb">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              ) : (
                <span style="font-size: 2rem;">📄</span>
              )}
            </div>
            <div class="card-body">
              <span class="badge">{post.data.category || 'Guide'}</span>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.description || post.data.excerpt || '실무 문제 해결 절차를 상세히 안내합니다.'}</p>
              <div class="card-footer">
                <span>{post.data.publishDate ? new Date(post.data.publishDate).toLocaleDateString() : '최신'}</span>
                <span style="font-weight: 700; text-transform: uppercase;">{postLang}</span>
              </div>
            </div>
          </a>
        );
      })}
      <div id="no-posts" class="no-posts">해당 언어로 발행된 글이 아직 없습니다.</div>
    </div>
  </main>

  <footer>
    <p>Copyright © 2026 LifeWebLab • Global Problem Solving Hub</p>
  </footer>

  <script is:inline>
    function setupLanguageFilter() {
      const selector = document.getElementById('lang-selector');
      const cards = document.querySelectorAll('.post-card');
      const noPosts = document.getElementById('no-posts');

      const userLang = (navigator.language || navigator.userLanguage || 'ko').slice(0, 2).toLowerCase();
      const supported = ['ko', 'en', 'ja', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl', 'id', 'vi'];
      const defaultLang = supported.includes(userLang) ? userLang : 'ko';

      if (selector) {
        selector.value = defaultLang;
      }

      function applyFilter(target) {
        let count = 0;
        cards.forEach(card => {
          if (card.getAttribute('data-lang') === target) {
            card.style.display = 'flex';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noPosts) {
          noPosts.style.display = count === 0 ? 'block' : 'none';
        }
      }

      applyFilter(defaultLang);

      if (selector) {
        selector.addEventListener('change', (e) => {
          applyFilter(e.target.value);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguageFilter);
    } else {
      setupLanguageFilter();
    }
  </script>
</body>
</html>
