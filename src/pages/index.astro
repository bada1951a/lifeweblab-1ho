---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// 생성된 은하수 대문 이미지 불러오기 (src/assets/images/galaxy.png)
import galaxyImg from '~/assets/images/galaxy.png';

const metadata = {
  title: 'Daily Prompt Hack — Advanced AI & Prompt Engineering Insights',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Prompts',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
    image={{
      src: galaxyImg,
      alt: 'Daily Prompt Hack - Advanced AI & Prompt Engineering Blueprints',
    }}
  >
    <Fragment slot="title">
      Advanced AI & Prompt Engineering,<br />
      <span class="text-accent dark:text-white highlight">Daily Prompt Hack</span>
    </Fragment>

    <Fragment slot="subtitle">
      Bridge the gap between human intent and machine execution. Actionable prompt blueprints, LLM reasoning workflows, and AI optimization guides.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Prompt Blueprints"
    information="Explore battle-tested generative AI workflows and advanced prompt architectures."
    count={8}
  />
</Layout>
