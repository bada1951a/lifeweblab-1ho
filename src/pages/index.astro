---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'LifeWebLab — Global Troubleshooting & Solutions',
  ignoreTitleTemplate: true,
};

// 1. post 컬렉션 글 전체 가져오기
let allPosts = [];
try {
  allPosts = await getCollection('post');
} catch (e) {}

// 최신 발행일 순 정렬
allPosts.sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});

// 12개국 언어 정의
const languages = [
  { code: 'ko', label: '한국어' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'de', label: 'Deutsch' },
  { code: 'fr', label: 'Français' },
  { code: 'es', label: 'Español' },
  { code: 'it', label: 'Italiano' },
  { code: 'pt', label: 'Português' },
  { code: 'nl', label: 'Nederlands' },
  { code: 'pl', label: 'Polski' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'vi', label: 'Tiếng Việt' },
];
---

<Layout metadata={metadata}>
  <section class="px-4 sm:px-6 py-8 sm:py-12 max-w-6xl mx-auto">
    <!-- 상단 바: 타이틀 및 국적/언어 전환 셀렉터 -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 dark:border-gray-700 pb-6 mb-8 gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          최신 문제해결 가이드
        </h1>
        <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">
          해외 결제 및 글로벌 비즈니스 오류 해결 솔루션입니다.
        </p>
      </div>

      <!-- 12개국 지구본 셀렉터 -->
      <div class="inline-flex items-center gap-2 bg-gray-100 dark:bg-slate-800 px-3.5 py-1.5 rounded-full border border-gray-300 dark:border-gray-600 self-start sm:self-auto shadow-sm">
        <span class="text-base">🌐</span>
        <select id="lang-selector" aria-label="Language selector" class="bg-transparent text-sm font-semibold text-gray-800 dark:text-gray-200 outline-none cursor-pointer">
          {languages.map((lang) => (
            <option value={lang.code} class="text-gray-900 bg-white dark:bg-slate-800 dark:text-white">
              {lang.label}
            </option>
          ))}
        </select>
      </div>
    </div>

    <!-- 블로그 포스트 카드 그리드 -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="posts-container">
      {allPosts.map((post) => {
        const postLang = post.id.split('/')[0] || 'ko';
        const cleanSlug = post.slug ? post.slug.split('/').pop() : post.id.replace(/\.[^/.]+$/, '').split('/').pop();
        // AstroWind 정규 상세 경로와 직관적인 slug 경로 모두 매핑
        const postUrl = `/${cleanSlug}`;

        return (
          <article 
            class="post-card flex flex-col bg-white dark:bg-slate-900 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition duration-200"
            data-lang={postLang}
          >
            {post.data.image && (
              <a href={postUrl} class="block h-48 overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover hover:scale-105 transition duration-300" loading="lazy" />
              </a>
            )}
            <div class="flex-1 p-5 flex flex-col justify-between">
              <div>
                <span class="inline-block text-xs font-semibold text-primary uppercase tracking-wider mb-2">
                  {post.data.category || 'Troubleshooting'}
                </span>
                <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-2 leading-snug hover:text-primary transition line-clamp-2">
                  <a href={postUrl}>{post.data.title}</a>
                </h2>
                <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                  {post.data.description || post.data.excerpt || '실무 문제 해결 절차를 상세히 안내합니다.'}
                </p>
              </div>
              <div class="text-xs text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-3 flex justify-between items-center">
                <span>{post.data.publishDate ? new Date(post.data.publishDate).toLocaleDateString() : '최신'}</span>
                <span class="px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 font-bold uppercase tracking-wider text-[10px] text-gray-500">
                  {postLang}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 포스트가 없을 때 표시할 안내 박스 -->
    <div id="no-posts" class="hidden text-center py-20 text-gray-500">
      <p class="text-base">해당 언어로 발행된 가이드가 아직 없습니다.</p>
    </div>
  </section>

  <!-- 접속자 언어 자동 감지 및 실시간 카드 스위칭 로직 -->
  <script is:inline>
    function setupLanguageFilter() {
      const selector = document.getElementById('lang-selector');
      const cards = document.querySelectorAll('.post-card');
      const noPosts = document.getElementById('no-posts');

      // 1. 브라우저 언어 판별 (기본값 ko)
      const userLang = (navigator.language || navigator.userLanguage || 'ko').slice(0, 2).toLowerCase();
      const supported = ['ko', 'en', 'ja', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl', 'id', 'vi'];
      const defaultLang = supported.includes(userLang) ? userLang : 'ko';

      if (selector) {
        selector.value = defaultLang;
      }

      // 2. 해당 언어의 글만 보이도록 필터링
      function applyFilter(target) {
        let count = 0;
        cards.forEach(card => {
          if (card.getAttribute('data-lang') === target) {
            card.style.display = 'flex';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noPosts) {
          noPosts.style.display = count === 0 ? 'block' : 'none';
        }
      }

      applyFilter(defaultLang);

      // 3. 사용자가 지구본 드롭다운을 직접 변경했을 때
      if (selector) {
        selector.addEventListener('change', (e) => {
          applyFilter(e.target.value);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguageFilter);
    } else {
      setupLanguageFilter();
    }
  </script>
</Layout>
