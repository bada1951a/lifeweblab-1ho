---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;

const adminLanguages = [
  { code: 'ko', name: '🇰🇷 한국어 (KO)' },
  { code: 'en', name: '🇺🇸 English (EN)' },
  { code: 'ja', name: '🇯🇵 日本語 (JA)' },
  { code: 'vi', name: '🇻🇳 Tiếng Việt (VI)' },
  { code: 'pt', name: '🇧🇷 Português (PT)' },
  { code: 'de', name: '🇩🇪 Deutsch (DE)' },
  { code: 'fr', name: '🇫🇷 Français (FR)' },
  { code: 'es', name: '🇪🇸 Español (ES)' },
  { code: 'id', name: '🇮🇩 Indonesia (ID)' },
  { code: 'it', name: '🇮🇹 Italiano (IT)' },
  { code: 'nl', name: '🇳🇱 Nederlands (NL)' },
  { code: 'pl', name: '🇵🇱 Polski (PL)' },
];
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-6 sm:gap-8 py-8 md:py-12">
      <!-- 왼쪽 영역: 너비를 6칸으로 넉넉하게 확장하여 약관이 가로 한 줄로 배치되도록 수정 -->
      <div class="col-span-12 lg:col-span-6">
        <div class="mb-3">
          <a class="inline-block font-bold text-xl tracking-tight" href={getHomePermalink()}>{SITE?.name}</a>
        </div>
        <div class="text-sm text-muted flex flex-wrap items-center gap-x-2 gap-y-1">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index > 0 && <span class="text-gray-400 select-none">·</span>}
                <a
                  class="text-muted hover:text-gray-700 dark:text-gray-400 hover:underline transition duration-150 ease-in-out whitespace-nowrap"
                  href={href}
                  set:html={text}
                />
              </>
            ))
          }
          <!-- 관리자 전용 숨김 지구본 버튼 -->
          <span class="text-gray-400 select-none">·</span>
          <button
            id="admin-lang-btn"
            type="button"
            class="hover:scale-125 transition-transform cursor-pointer text-base leading-none p-0.5 inline-flex items-center"
            title="Global Language Hub"
          >
            🌐
          </button>
        </div>
      </div>

      <!-- 오른쪽 영역: Categories, Blog를 오른쪽으로 이동하여 3칸씩 정돈 -->
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 lg:col-span-3">
            <div class="dark:text-gray-300 font-semibold mb-3">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm space-y-2">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out whitespace-nowrap"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div
      class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-gray-100 dark:border-slate-800/80"
    >
      {
        socialLinks?.length > 0 && (
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="text-sm dark:text-muted">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>

  <!-- 관리자 전용 언어 선택 모달 -->
  <div
    id="admin-lang-modal"
    class="fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm hidden"
    style="display: none;"
  >
    <div
      class="bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 max-w-md w-full mx-4 shadow-2xl relative"
    >
      <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100 dark:border-slate-800">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">🌐 Global Edition Hub</h3>
        <button
          id="admin-modal-close"
          type="button"
          class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-xl font-bold px-2 py-1 cursor-pointer"
        >
          ✕
        </button>
      </div>
      <p class="text-xs text-muted mb-4">Select an edition to review localized posts.</p>

      <div class="grid grid-cols-2 gap-2">
        {
          adminLanguages.map(({ code, name }) => (
            <a
              href={`/${code}`}
              class="px-3 py-2 text-xs sm:text-sm font-medium rounded-lg border border-gray-200 dark:border-slate-700 hover:border-primary hover:bg-primary/5 dark:hover:bg-primary/10 transition-colors flex items-center"
            >
              {name}
            </a>
          ))
        }
      </div>

      <div class="mt-4 pt-3 border-t border-gray-100 dark:border-slate-800 flex justify-between text-xs text-muted">
        <a href="/sitemap-0.xml" target="_blank" class="hover:underline">📑 Full Sitemap XML</a>
        <span>Admin Only</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  function setupAdminLangModal() {
    const btn = document.getElementById('admin-lang-btn');
    const modal = document.getElementById('admin-lang-modal');
    const closeBtn = document.getElementById('admin-modal-close');

    if (!btn || !modal) return;

    btn.onclick = function (e) {
      e.preventDefault();
      modal.style.display = 'flex';
      modal.classList.remove('hidden');
    };

    if (closeBtn) {
      closeBtn.onclick = function () {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      };
    }

    modal.onclick = function (e) {
      if (e.target === modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    };
  }

  setupAdminLangModal();
  document.addEventListener('astro:page-load', setupAdminLangModal);
</script>
